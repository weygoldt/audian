#!/bin/sh
# Refuse a commit whose Python is not ruff-clean.  Enabled per clone with
#     git config core.hooksPath .githooks
# Checks the staged files as they are in the working tree, so a partially
# staged file is judged by its unstaged lines too.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -z "$files" ] && exit 0
ruff=.venv/bin/ruff
[ -x "$ruff" ] || ruff=$(command -v ruff) || {
    echo "pre-commit: ruff not found; run \`uv sync\`" >&2
    exit 1
}
# shellcheck disable=SC2086  # paths come from git and are split on purpose
"$ruff" format --check $files && "$ruff" check $files && exit 0
echo "pre-commit: run \`.venv/bin/ruff format\` and \`.venv/bin/ruff check --fix\`" >&2
exit 1
