# Python and its tools
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.json
coverage.xml

# Editors and the local environment
.idea/
*~
.envrc
.direnv/

# Analysis output left beside a recording
*.npy
*.pdf
*.txt
# the bundled font's licence (SIL OFL) must ship with it
!src/audian/fonts/*.txt

# Label sidecars are the reader's own work on a recording, written next to it
# by the browser; one was committed by accident in 5020b8c.
*-editable-labels.csv

# Local recordings for tests and screenshots from the smoke test
.devdata/
.devshots/

# Agent worktrees and scratch. Worktrees live at .claude/worktrees/<name> so the
# primary checkout can stay on master -- one held elsewhere silently strands it.
.claude/
